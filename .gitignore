# PyCharm / JetBrains
.idea/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Env / secrets
.env
.venv/

# Data (no versionar raw/interim)
data/raw/
data/interim/

# Model outputs / reports (solo en la raíz del repo)
# Importante: anclado con "/" para no ignorar src/models/
/models/
/reports/figures/

# Asegurar que el código fuente de modelos sí se pueda versionar
!src/models/
!src/models/**

# Clean rename
data/processed/*.csv
!data/processed/.gitkeep

# Legacy notebooks archive pending review
notebooks/archive/*
!notebooks/archive/README.md
